              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register/institution",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register", "institution"]
